  "components": {
    "schemas": {
      "ContainRequest": {
        "properties": {
          "ttl_seconds": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 86400.0,
                "minimum": 60.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Ttl Seconds"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "title": "ContainRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IncidentUpdate": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "new",
              "triaged",
              "contained",
              "closed"
            ],
            "title": "Status"
          },
          "note": {
            "type": "string",
            "maxLength": 1000,
            "title": "Note",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "IncidentUpdate"
      },
      "IngestRequest": {
        "properties": {
          "sensor_id": {
            "type": "string",
            "maxLength": 80,
            "title": "Sensor Id",
            "default": "api-sensor"
          },
          "event": {
            "additionalProperties": true,
            "type": "object",
            "title": "Event"
          }
        },
        "type": "object",
        "required": [
          "event"
        ],
        "title": "IngestRequest"
      },
      "IngestResponse": {
        "properties": {
          "event_id": {
            "type": "integer",
            "title": "Event Id"
          },
          "detection_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Detection Ids"
          },
          "incident_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Incident Ids"
          }
        },
        "type": "object",
        "required": [
          "event_id",
          "detection_ids",
          "incident_ids"
        ],
        "title": "IngestResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
