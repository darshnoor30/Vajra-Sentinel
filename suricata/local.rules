# Vajra Sentinel local detection examples.
# Scope these rules to HOME_NET and tune thresholds against your baseline.

alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"VAJRA Repeated SSH connection attempts - authentication outcome unknown"; flow:to_server,stateless; flags:S; threshold:type both, track by_src, count 12, seconds 60; classtype:attempted-recon; sid:9000001; rev:1; metadata:mitre_tactic_id TA0006, mitre_technique_id T1110;)

alert tcp $EXTERNAL_NET any -> $HOME_NET [23,445,3389] (msg:"VAJRA External connection to high-risk remote service"; flow:to_server; flags:S; classtype:attempted-recon; sid:9000002; rev:1; metadata:mitre_tactic_id TA0008, mitre_technique_id T1021;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"VAJRA Suspicious administrative path probe"; flow:established,to_server; http.uri; content:"/admin"; nocase; classtype:web-application-activity; sid:9000003; rev:1; metadata:mitre_tactic_id TA0043, mitre_technique_id T1595.003;)

alert dns $HOME_NET any -> $EXTERNAL_NET any (msg:"VAJRA Long DNS query - inspect for encoded data"; dns.query; pcre:"/^[A-Za-z0-9_-]{45,}\./"; classtype:bad-unknown; sid:9000004; rev:1; metadata:mitre_tactic_id TA0011, mitre_technique_id T1071.004;)

